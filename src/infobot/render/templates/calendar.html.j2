<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<style>
  @font-face { font-family: "Oswald"; src: url("{{ fonts }}/Oswald.ttf"); font-weight: 200 700; }
  @font-face { font-family: "Inter"; src: url("{{ fonts }}/Inter.ttf"); font-weight: 100 900; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { width: {{ width|default(1600) }}px; min-height: {{ height }}px; }
  body { font-family: "Inter", sans-serif; color: #fff; padding: 48px 56px 40px;
    background: radial-gradient(80% 50% at 100% 0%, #1e5eff 0%, #10183a 45%, #07080d 100%); }
  header { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 28px; }
  .brand { font: 600 22px "Oswald"; letter-spacing: .18em; text-transform: uppercase; opacity: .85; }
  h1 { font: 700 76px/1 "Oswald"; text-transform: uppercase; margin-top: 6px; }
  h1 small { font: 600 30px "Oswald"; opacity: .7; margin-left: 14px; letter-spacing: .04em; }
  .badge { display: inline-block; font: 700 18px "Oswald"; letter-spacing: .1em; color: #3fff8f;
    border: 2px solid #3fff8f; border-radius: 999px; padding: 4px 14px; margin-top: 10px; }
  .upd { font: 500 19px "Inter"; opacity: .7; text-align: right; }
  .grid { display: grid; grid-template-columns: {{ label_width|default(420) }}px 1fr; }
  .days { display: grid; grid-template-columns: repeat({{ days|length }}, 1fr); }
  .day { text-align: center; padding: 8px 0 10px; border-left: 1px solid rgba(255,255,255,.08); }
  .day .dow { font: 600 14px "Inter"; text-transform: uppercase; letter-spacing: .1em; opacity: .6; }
  .day .num { font: 700 26px "Oswald"; }
  .day.weekend { background: rgba(255,255,255,.035); }
  .day.today { background: rgba(63,255,143,.14); }
  .day.today .num { color: #3fff8f; }
  .row { display: contents; }
  .label { padding: 12px 18px 12px 0; display: flex; align-items: center; gap: 14px; min-height: 78px;
    border-top: 1px solid rgba(255,255,255,.08); }
  .label .em { font-size: 34px; width: 44px; text-align: center; }
  .label .t { font: 600 13px "Inter"; text-transform: uppercase; letter-spacing: .1em; opacity: .6; }
  .label .n { font: 700 24px/1.1 "Oswald"; }
  .label .d { font: 500 14px "Inter"; opacity: .65; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 340px; }
  .track { position: relative; border-top: 1px solid rgba(255,255,255,.08);
    background-image: linear-gradient(90deg, rgba(255,255,255,.08) 1px, transparent 1px);
    background-size: calc(100% / {{ days|length }}) 100%; }
  .bar { position: absolute; top: 16px; bottom: 16px; border-radius: 12px; display: flex; align-items: center;
    padding: 0 14px; font: 700 17px "Oswald"; letter-spacing: .02em; color: #0b0d14; white-space: nowrap;
    box-shadow: 0 6px 20px rgba(0,0,0,.35); overflow: visible; }
  .bar.open { border-top-right-radius: 0; border-bottom-right-radius: 0; }
  .bar { z-index: 2; }
  .vip { display: inline-block; font: 700 14px "Oswald"; letter-spacing: .08em; color: #0b0d14; background: linear-gradient(90deg,#ffd76a,#f5a623);
    border-radius: 999px; padding: 2px 10px; margin-left: 8px; vertical-align: middle; }
  .bar.noend { opacity: .55; }
  .bar.short { color: transparent; }
  .outside { position: absolute; top: 0; bottom: 0; display: flex; align-items: center; padding-left: 12px;
    font: 700 17px "Oswald"; white-space: nowrap; z-index: 3; text-shadow: 0 2px 8px rgba(0,0,0,.8); }
  .bar.upcoming { background-image: repeating-linear-gradient(135deg, rgba(255,255,255,.28) 0 10px, transparent 10px 20px) !important; }
  .now { position: absolute; top: 0; bottom: 0; width: 3px; background: #3fff8f; box-shadow: 0 0 12px #3fff8f; z-index: 1; }
  .empty { grid-column: 1 / -1; font: 600 32px "Oswald"; opacity: .7; text-align: center; padding: 60px 0; }
  .later { margin-top: 28px; }
  .later h2 { font: 700 26px "Oswald"; text-transform: uppercase; margin-bottom: 10px; opacity: .85; }
  .later div { font: 600 20px "Inter"; opacity: .8; margin-bottom: 8px; }
  footer { margin-top: 26px; display: flex; justify-content: space-between; font: 500 16px "Inter"; opacity: .55; }
</style>
</head>
<body>
  <header>
    <div>
      <div class="brand">{{ brand }}</div>
      <h1>{{ title|default("📅 Calendario") }}<small>{{ range_label }}</small></h1>
      <div class="badge">{{ badge|default("✅ SOLO CONTENIDO OFICIAL") }}</div>
    </div>
    <div class="upd">Actualizado<br><b>{{ updated }}</b></div>
  </header>

  <div class="grid">
    <div></div>
    <div class="days">
      {% for d in days %}<div class="day{% if d.weekend %} weekend{% endif %}{% if d.today %} today{% endif %}"><div class="dow">{{ d.dow }}</div><div class="num">{{ d.num }}</div></div>{% endfor %}
    </div>
    {% for r in rows %}
    <div class="label">
      <div class="em">{{ r.emoji }}</div>
      <div><div class="t">{{ r.label }}</div><div class="n">{{ r.name }}{% if r.vip %}<span class="vip">⭐ VIP</span>{% endif %}</div>{% if r.detail %}<div class="d">{{ r.detail }}</div>{% endif %}</div>
    </div>
    <div class="track">
      <div class="bar{% if r.open_end %} open{% endif %}{% if r.upcoming %} upcoming{% endif %}{% if r.no_end %} noend{% endif %}{% if r.short %} short{% endif %}"
           style="left: {{ r.left }}%; width: {{ r.width }}%; background-color: {{ r.color }};">{{ r.when }}</div>
      {% if r.short %}<div class="outside" style="left: {{ r.left + r.width }}%; color: {{ r.color }};">{{ r.when }}</div>{% endif %}
      <div class="now" style="left: {{ now_pct }}%"></div>
    </div>
    {% else %}
    <div class="empty">No hay nada oficial activo ahora mismo 💤</div>
    {% endfor %}
  </div>

  {% if later %}
  <div class="later">
    <h2>🗓️ Más adelante</h2>
    {% for l in later %}<div>{{ l.emoji }} {{ l.name }} — desde {{ l.when }}</div>{% endfor %}
  </div>
  {% endif %}

  <footer><span>{{ brand }} · Horas de España{% if source %} · {{ source }}{% endif %}</span><span>Rayada = aún no ha empezado · Clara = sin fecha de fin · Línea verde = ahora</span></footer>
</body>
</html>
