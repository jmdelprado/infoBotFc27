{
  "$comment": "Salida estructurada que Claude debe devolver para un lote de tweets. Copia de src/infobot/analysis.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items",
    "ignored_tweet_ids"
  ],
  "properties": {
    "ignored_tweet_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "source_type",
          "title",
          "summary",
          "details",
          "key_facts",
          "tweet_ids",
          "images"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "promo",
              "card",
              "objective",
              "sbc",
              "evolution",
              "event"
            ]
          },
          "source_type": {
            "type": "string",
            "enum": [
              "official",
              "leak"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 90
          },
          "summary": {
            "type": "string",
            "maxLength": 300
          },
          "details": {
            "type": "string",
            "maxLength": 2500
          },
          "key_facts": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "value"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              }
            }
          },
          "tweet_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "images": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "promo": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "start": {
                "type": "string"
              },
              "end": {
                "type": "string"
              }
            }
          },
          "cards": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "player"
              ],
              "properties": {
                "player": {
                  "type": "string"
                },
                "rating": {
                  "type": "integer"
                },
                "position": {
                  "type": "string"
                },
                "club": {
                  "type": "string"
                },
                "nation": {
                  "type": "string"
                },
                "league": {
                  "type": "string"
                },
                "promo": {
                  "type": "string"
                }
              }
            }
          },
          "objectives": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "reward": {
                  "type": "string"
                },
                "ends": {
                  "type": "string"
                },
                "starts": {
                  "type": "string"
                }
              }
            }
          },
          "sbcs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "reward": {
                  "type": "string"
                },
                "ends": {
                  "type": "string"
                },
                "cost": {
                  "type": "string"
                },
                "starts": {
                  "type": "string"
                }
              }
            }
          },
          "evolutions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "cost": {
                  "type": "string"
                },
                "requirements": {
                  "type": "string"
                },
                "upgrades": {
                  "type": "string"
                },
                "starts": {
                  "type": "string"
                },
                "ends": {
                  "type": "string"
                }
              }
            }
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "starts": {
                  "type": "string"
                },
                "ends": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}